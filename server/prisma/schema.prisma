generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PartnerCategory {
  id      String    @id
  label   String
  Partner Partner[]
}

model Partner {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  categoryId  String?
  city        String?
  description String?
  featured    Boolean          @default(false)
  archived    Boolean?         @default(false)
  ownerId     String?          @unique
  Category    PartnerCategory? @relation(fields: [categoryId], references: [id])
  Owner       User?            @relation("PartnerOwner", fields: [ownerId], references: [id])
  Transaction Transaction[]
}

model QrCode {
  id          String        @id
  code        String        @unique
  status      String        @default("ACTIVE")
  userId      String
  createdAt   DateTime      @default(now())
  amount      Decimal       @db.Decimal(10, 2)
  expiresAt   DateTime
  label       String?
  User        User          @relation(fields: [userId], references: [id])
  Transaction Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  status    String   @default("SUCCESS")
  userId    String
  partnerId String?
  qrCodeId  String?  @unique
  redeemedByUserId String?
  RedeemedBy User? @relation("RedeemedPayments", fields: [redeemedByUserId], references: [id])
  createdAt DateTime @default(now())
  label     String   @default("Transaction")
  ARCHIVED  Boolean?
  Partner   Partner? @relation(fields: [partnerId], references: [id])
  QrCode    QrCode?  @relation(fields: [qrCodeId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  role          String        @default("EMPLOYEE")
  createdAt     DateTime      @default(now())
  balance       Float         @default(0)
  company       String?
  firstName     String        @default("Utilisateur")
  lastName      String        @default("Démo")
  monthlyCredit Float         @default(0)
  monthlySpend  Float         @default(0)
  password      String        @default("")
  status        String?
  PartnerApplication PartnerApplication?
  OwnedPartner  Partner?       @relation("PartnerOwner")
  Sessions      Session[]
  RedeemedPayments Transaction[] @relation("RedeemedPayments")
  QrCode        QrCode[]
  Transaction   Transaction[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentAudit {
  id            String   @id @default(cuid())
  transactionId String   @unique
  qrCodeId      String
  actorId       String
  createdAt     DateTime @default(now())
  amount        Decimal  @db.Decimal(10, 2)
}

model PartnerApplication {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  siret       String   @unique
  objetSocial String
  categoryId  String
  city        String
  phone       String
  status      String   @default("PENDING")
  submittedAt DateTime @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  motif       String?
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
