generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PartnerCategory {
  id      String    @id
  label   String
  Partner Partner[]
}

model Partner {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  categoryId  String?
  city        String?
  description String?
  featured    Boolean          @default(false)
  archived    Boolean?         @default(false)
  Category    PartnerCategory? @relation(fields: [categoryId], references: [id])
  Transaction Transaction[]
}

model QrCode {
  id          String        @id
  code        String        @unique
  status      String        @default("ACTIVE")
  userId      String
  createdAt   DateTime      @default(now())
  amount      Decimal       @db.Decimal(10, 2)
  expiresAt   DateTime
  label       String?
  User        User          @relation(fields: [userId], references: [id])
  Transaction Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  status    String   @default("SUCCESS")
  userId    String
  partnerId String?
  qrCodeId  String?
  createdAt DateTime @default(now())
  label     String   @default("Transaction")
  ARCHIVED  Boolean?
  Partner   Partner? @relation(fields: [partnerId], references: [id])
  QrCode    QrCode?  @relation(fields: [qrCodeId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  role          String        @default("EMPLOYEE")
  createdAt     DateTime      @default(now())
  balance       Float         @default(0)
  company       String?
  firstName     String        @default("Utilisateur")
  lastName      String        @default("Démo")
  monthlyCredit Float         @default(0)
  monthlySpend  Float         @default(0)
  password      String        @default("")
  status        String?
  QrCode        QrCode[]
  Transaction   Transaction[]
}
